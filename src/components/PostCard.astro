---
import Cover from './Cover.astro';
import Icon from './Icon.astro';
import { formatDate, readingTime, postUrl, type Post } from '../lib/posts';
interface Props {
  post: Post;
  featured?: boolean;
}
const { post, featured = false } = Astro.props;
---

<article
  class:list={['post-card', { 'featured-card': featured }]}
  data-category={post.data.category}
>
  <a class="card-cover-link" href={postUrl(post)} tabindex="-1" aria-hidden="true">
    <Cover type={post.data.cover} />
    {featured && <span class="feature-sticker label">★ EDITOR'S PICK</span>}
  </a>
  <div class="card-body">
    <div class="post-meta">
      <span class:list={['category-badge', `category-${post.data.category}`]}>
        {post.data.category}
      </span>
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <span>{readingTime(post.body)} MIN READ</span>
    </div>
    <h3>
      <a href={postUrl(post)}>{post.data.title}</a>
    </h3>
    <p>{post.data.description}</p>
    <div class="card-bottom">
      <span class="card-tags">
        {post.data.tags.slice(0, 2).map((tag) => (
          <span>#{tag}</span>
        ))}
      </span>
      <a href={postUrl(post)} class="read-link" aria-label={`阅读：${post.data.title}`}>
        <span>READ STORY</span>
        <Icon name="arrow" size={19} />
      </a>
    </div>
  </div>
</article>
