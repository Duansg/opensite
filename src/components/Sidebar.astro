---
import PixelPortrait from './PixelPortrait.astro';
import Icon from './Icon.astro';
import { site } from '../config';
import { categories } from '../lib/categories';
import { ui, formatMessage } from '../i18n';
import { getPosts, tagUrl } from '../lib/posts';
const posts = await getPosts();
const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
---

<aside class="blog-sidebar" aria-label={ui.sidebar.label}>
  <div class="about-sheet">
    <div class="sheet-top label">
      {ui.sidebar.kicker} <span>↘</span>
    </div>
    <div class="about-content">
      <div class="avatar-square">
        <PixelPortrait alt={formatMessage(ui.common.avatar, { author: site.author })} />
      </div>
      <h3>
        {formatMessage(ui.common.greeting, { author: site.author.toUpperCase() })}
        <span class="sky-dot">.</span>
      </h3>
      <p>
        {ui.sidebar.intro.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))}
      </p>
      <a href="/about/" class="text-link">
        {ui.sidebar.about} <Icon name="external" size={17} />
      </a>
    </div>
    <div class="about-status label">
      <span class="status-pixel"></span>
      {ui.sidebar.status}
    </div>
  </div>
  <div class="sidebar-block">
    <h3 class="label sidebar-heading">{ui.sidebar.categories}</h3>
    {categories.map((category) => (
      <a class="category-row" href={`/blog/?category=${encodeURIComponent(category)}`}>
        <span>
          {ui.categories[category].label}
          <small>{ui.categories[category].caption}</small>
        </span>
        <b class="label">
          {String(posts.filter((post) => post.data.category === category).length).padStart(2, '0')}{' '}
          ↗
        </b>
      </a>
    ))}
  </div>
  <div class="sidebar-block">
    <h3 class="label sidebar-heading">{ui.sidebar.tags}</h3>
    <div class="tag-cloud">
      {tags.map((tag) => (
        <a href={tagUrl(tag)}>#{tag}</a>
      ))}
    </div>
  </div>
  <div class="little-note">
    <span class="label">{ui.sidebar.reminder}</span>
    <p>
      {ui.sidebar.reminderLines[0]}
      <br />
      {ui.sidebar.reminderLines[1]}
      <br />
      <span>{ui.sidebar.reminderLines[2]}</span>
    </p>
    <span class="label">{ui.sidebar.note}</span>
  </div>
</aside>
