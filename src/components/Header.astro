---
import Icon from './Icon.astro';
import PixelPortrait from './PixelPortrait.astro';
import { site } from '../config';
import { ui, formatMessage } from '../i18n';
const [brandLead, ...brandRest] = site.name.split('.');
const path = Astro.url.pathname;
const links = [
  { href: '/', ...ui.nav.home },
  { href: '/blog/', ...ui.nav.writing },
  { href: '/archive/', ...ui.nav.archive },
  { href: '/about/', ...ui.nav.about },
];
---

<header class="site-header sky-grid">
  <nav class="wrap nav" aria-label={ui.nav.label}>
    <a href="/" class="logo" aria-label={formatMessage(ui.nav.homeLabel, { name: site.name })}>
      <PixelPortrait />
      {brandLead}
      {brandRest.length > 0 && (
        <>
          <span class="logo-dot">.</span>
          {brandRest.join('.')}
        </>
      )}
    </a>
    <div class="desktop-nav">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            'nav-link',
            { active: link.href === '/' ? path === '/' : path.startsWith(link.href) },
          ]}
          aria-current={
            (link.href === '/' ? path === '/' : path.startsWith(link.href)) ? 'page' : undefined
          }
        >
          {link.label}
          {link.caption !== link.label.toUpperCase() && <span>{link.caption}</span>}
        </a>
      ))}
    </div>
    <div class="nav-actions">
      <button class="search-toggle icon-button" aria-label={ui.nav.search} data-search-open>
        <Icon name="search" />
        <kbd>⌘ K</kbd>
      </button>
      <a class="btn dark nav-rss" href="/rss.xml">
        <Icon name="rss" size={15} />
        {ui.common.subscribeRss}
      </a>
      <button
        class="icon-button mobile-toggle"
        aria-label={ui.nav.open}
        data-label-open={ui.nav.open}
        data-label-close={ui.nav.close}
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <Icon name="menu" />
      </button>
    </div>
  </nav>
  <div id="mobile-menu" class="mobile-menu wrap" hidden>
    {links.map((link) => (
      <a href={link.href}>
        {link.label}
        {link.caption !== link.label.toUpperCase() && <span class="label">{link.caption}</span>}
      </a>
    ))}
    <a href="/rss.xml">
      {ui.common.subscribeRss} <Icon name="rss" size={16} />
    </a>
  </div>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.mobile-toggle');
  const menu = document.querySelector<HTMLElement>('#mobile-menu');
  toggle?.addEventListener('click', () => {
    if (!menu) return;
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    toggle.setAttribute(
      'aria-label',
      (expanded ? toggle.dataset.labelOpen : toggle.dataset.labelClose) || '',
    );
    menu.hidden = expanded;
  });
</script>
