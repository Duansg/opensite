---
import Icon from './Icon.astro';
import { ui } from '../i18n';
---

<dialog
  class="search-dialog"
  aria-labelledby="search-heading"
  data-messages={JSON.stringify(ui.search)}
>
  <div class="search-top">
    <span id="search-heading" class="label">
      {ui.search.heading}
    </span>
    <button class="icon-button" data-search-close aria-label={ui.search.close}>
      <Icon name="close" />
    </button>
  </div>
  <form role="search" class="search-form">
    <Icon name="search" />
    <label class="sr-only" for="global-search">
      {ui.search.label}
    </label>
    <input
      id="global-search"
      type="search"
      placeholder={ui.search.placeholder}
      autocomplete="off"
    />
    <kbd>{ui.search.escapeKey}</kbd>
  </form>
  <div id="search-results" class="search-results" aria-live="polite">
    <p class="search-hint">{ui.search.hint}</p>
  </div>
  <div class="search-bottom label">
    {ui.search.help} <span>{ui.search.keyboard}</span>
  </div>
</dialog>
<script>
  import { initSearch } from '../scripts/search';
  initSearch();
</script>
