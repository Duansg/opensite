---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getPosts } from '../../lib/posts';
import { locale } from '../../config';
import { ui, formatMessage, formatCount } from '../../i18n';
export async function getStaticPaths() {
  const posts = await getPosts();
  return [...new Set(posts.flatMap((post) => post.data.tags))].map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}
const { tag, posts } = Astro.props;
---

<Base title={formatMessage(ui.tags.title, { tag })}>
  <section class="page-hero sky-grid">
    <div class="wrap">
      <span class="label">{ui.tags.kicker}</span>
      <h1 class="page-heading">
        #{tag}
        <span class="outline">.</span>
      </h1>
      <p>{formatCount(ui.tags.description, posts.length, locale)}</p>
    </div>
  </section>
  <section class="wrap section">
    <div class="content-layout">
      <div class="post-grid">
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
        <a class="all-posts" href="/blog/">
          {ui.common.backToPosts}
        </a>
      </div>
      <Sidebar />
    </div>
  </section>
</Base>
