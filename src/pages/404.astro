---
import Base from '../layouts/Base.astro';
import { ui } from '../i18n';
---

<Base title={ui.notFound.title} noindex>
  <section class="not-found sky-grid">
    <div class="wrap">
      <span class="label">{ui.notFound.kicker}</span>
      <h1>404</h1>
      <h2>{ui.notFound.heading}</h2>
      <p>{ui.notFound.description}</p>
      <a class="btn dark" href="/">
        {ui.notFound.home}
      </a>
    </div>
  </section>
</Base>
