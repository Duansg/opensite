---
import Base from '../layouts/Base.astro';
import Sidebar from '../components/Sidebar.astro';
import Icon from '../components/Icon.astro';
import { getPosts, postUrl } from '../lib/posts';
import { locale } from '../config';
import { ui, formatCount } from '../i18n';
const posts = await getPosts();
const years = [...new Set(posts.map((post) => post.data.date.getUTCFullYear()))];
---

<Base title={ui.archive.title}>
  <section class="page-hero sky-grid">
    <div class="wrap">
      <span class="label">{ui.archive.kicker}</span>
      <h1 class="page-heading">
        {ui.archive.heading}
        <span class="outline">.</span>
      </h1>
      <p>{formatCount(ui.archive.description, posts.length, locale)}</p>
    </div>
  </section>
  <section class="wrap section">
    <div class="content-layout">
      <div>
        {years.map((year) => (
          <section class="archive-group">
            <h2 class="archive-year">
              {year}
              <small>
                {formatCount(
                  ui.common.storyCount,
                  posts.filter((post) => post.data.date.getUTCFullYear() === year).length,
                  locale,
                )}
              </small>
            </h2>
            {posts
              .filter((post) => post.data.date.getUTCFullYear() === year)
              .map((post) => (
                <a href={postUrl(post)} class="archive-row">
                  <time datetime={post.data.date.toISOString()}>
                    {post.data.date.toISOString().slice(5, 10).replace('-', ' / ')}
                  </time>
                  <div>
                    <h3 lang={post.data.lang}>{post.data.title}</h3>
                    <span class="label">
                      {ui.categories[post.data.category].label} ·{' '}
                      {post.data.tags.map((tag) => `#${tag}`).join(' ')}
                    </span>
                  </div>
                  <Icon name="external" />
                </a>
              ))}
          </section>
        ))}
      </div>
      <Sidebar />
    </div>
  </section>
</Base>
