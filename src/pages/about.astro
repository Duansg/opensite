---
import Base from '../layouts/Base.astro';
import PixelPortrait from '../components/PixelPortrait.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config';
import { ui, formatMessage } from '../i18n';
---

<Base title={ui.about.title}>
  <section class="page-hero sky-grid">
    <div class="wrap">
      <span class="label">{ui.about.kicker}</span>
      <h1 class="page-heading">
        {ui.about.heading}
        <span class="outline">.</span>
      </h1>
      <p>{ui.about.description}</p>
    </div>
  </section>
  <section class="wrap section about-layout">
    <div class="about-portrait">
      <PixelPortrait alt={formatMessage(ui.common.avatar, { author: site.author })} />
      <div class="label">
        <span>{ui.about.portraitId}</span>
        <span>{site.author.toUpperCase()} ↗</span>
      </div>
    </div>
    <div class="about-prose">
      <span class="label">{formatMessage(ui.about.person, { name: site.name })}</span>
      <h2>{formatMessage(ui.common.greeting, { author: site.author.toUpperCase() })}.</h2>
      <p>{formatMessage(ui.about.intro, { name: site.name })}</p>
      <h2>{ui.about.why}</h2>
      {ui.about.whyParagraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      <h2>{ui.about.topics}</h2>
      {ui.about.topicsParagraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      <div class="about-links">
        <a href={site.github} class="btn dark" target="_blank" rel="noopener noreferrer">
          <Icon name="code" size={17} />
          {ui.about.github} <Icon name="external" size={17} />
        </a>
        <a href="/rss.xml" class="btn">
          <Icon name="rss" size={16} />
          {ui.common.subscribeRss}
        </a>
      </div>
    </div>
  </section>
</Base>
