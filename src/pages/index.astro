---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import Sidebar from '../components/Sidebar.astro';
import Icon from '../components/Icon.astro';
import PixelPortrait from '../components/PixelPortrait.astro';
import { getPosts } from '../lib/posts';
import { locale } from '../config';
import { categories } from '../lib/categories';
import { ui, formatCount } from '../i18n';
const posts = await getPosts();
const featured = posts.find((post) => post.data.featured) || posts[0];
const latest = posts.filter((post) => post.id !== featured?.id).slice(0, 4);
const topics = categories.filter((category) =>
  posts.some((post) => post.data.category === category),
);
const ticker = ui.home.ticker;
---

<Base>
  <section class="hero sky-grid" aria-labelledby="hero-title">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <span class="kicker label">
          <b>{ui.home.hello}</b> {ui.home.welcome}
        </span>
        <h1 id="hero-title">
          <span>{ui.home.heading[0]}</span>
          <span class="outline">{ui.home.heading[1]}</span>
        </h1>
        <p class="hero-intro">
          {ui.home.intro.map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))}
        </p>
        <div class="hero-stats">
          <div>
            <b>{String(posts.length).padStart(2, '0')}</b>
            <span>{ui.common.stories}</span>
          </div>
          <div>
            <b>{String(topics.length).padStart(2, '0')}</b>
            <span>{ui.home.topics}</span>
          </div>
          <div>
            <b>∞</b>
            <span>{ui.home.curiosity}</span>
          </div>
        </div>
      </div>
      <div class="hero-stage">
        <span class="stage-hint label">{ui.home.portraitHint}</span>
        <span class="stage-id label px-corners">{ui.home.portraitId}</span>
        <div class="hero-portrait">
          <PixelPortrait class="hero-avatar-fallback" alt={ui.home.portraitAlt} />
          <canvas id="pixel-portrait" width="576" height="576" aria-hidden="true" hidden></canvas>
        </div>
        <span class="stage-note label">{ui.home.portraitNote}</span>
      </div>
    </div>
  </section>
  <div class="ticker" aria-hidden="true">
    <div class="ticker-row">
      {[...ticker, ...ticker].map((text) => (
        <span>{text}</span>
      ))}
    </div>
  </div>
  <section class="wrap section" aria-labelledby="latest-title">
    <div class="section-head">
      <div>
        <span class="label">{ui.home.latestLabel}</span>
        <h2 id="latest-title">
          {ui.home.latestTitle}
          <span class="sky-dot">.</span>
          <sup class="count">({String(posts.length).padStart(2, '0')})</sup>
        </h2>
      </div>
      <p>
        {ui.home.latestIntro.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))}
      </p>
    </div>
    <div class="content-layout">
      <div class="post-grid">
        {featured && <PostCard post={featured} featured />}
        {latest.map((post) => (
          <PostCard post={post} />
        ))}
        <a class="all-posts" href="/blog/">
          {ui.home.allPosts} <span>{formatCount(ui.home.counting, posts.length, locale)}</span>
          <Icon name="arrow" />
        </a>
      </div>
      <Sidebar />
    </div>
  </section>
</Base>
<script>
  import { initPixelPortrait } from '../scripts/pixel-portrait';
  initPixelPortrait();
</script>
