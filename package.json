{
  "name": "opensite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "dev:stop": "astro dev stop",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "verify": "npm run check && npm run build && node scripts/verify-build.mjs",
    "smoke": "node scripts/smoke-server.mjs",
    "new:post": "node scripts/new-post.mjs",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name opensite",
    "deploy:worker": "npm run build && wrangler deploy --config wrangler.worker.jsonc"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "astro": "7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "~5.9.3",
    "wrangler": "4.157.0"
  }
}
